{
  "id": "itau",
  "label": "Itaú Tradicional — Orçamento de Seguro (plataforma Porto)",
  "match": ["Orçamento de Seguro", "Itaú Tradicional"],
  "priority": 10,
  "fields": {
    "seguradora": {
      "pick": "text_regex",
      "page": 1,
      "anchor": "Itaú Tradicional",
      "regex": "(Ita[úu])\\s+Tradicional"
    },

    "segurado": {
      "pick": "under",
      "page": 1,
      "anchor": "Segurado(a)",
      "xlo": 12,
      "xhi": 40,
      "dy": 22,
      "regex": "^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ' .]{6,60}$",
      "not_regex": "\\d",
      "format": "upper"
    },

    "principal_condutor": {
      "pick": "under",
      "page": 1,
      "anchor": "Condutor",
      "exact": true,
      "xlo": 12,
      "xhi": 40,
      "dy": 22,
      "regex": "^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ' .]{6,60}$",
      "not_regex": "\\d",
      "format": "upper"
    },

    "veiculo": {
      "pick": "under",
      "page": 1,
      "anchor": "Veículo",
      "occurrence": 2,
      "xlo": 12,
      "xhi": 40,
      "dy": 22,
      "regex": "\\d{3,}\\s*(?:-\\s*)+([A-Za-z].+)$",
      "not_regex": "\\d{6,}",
      "min_len": 6,
      "max_words": 14
    },

    "ano_modelo": {
      "pick": "under",
      "page": 1,
      "anchor": "Ano Fabricação / Modelo",
      "xlo": 12,
      "xhi": 40,
      "dy": 22,
      "regex": "\\d{4}\\s*/\\s*\\d{4}",
      "replace": [["\\s*/\\s*", "/"]]
    },

    "data_proposta": {
      "pick": "under",
      "page": 1,
      "anchor": "Realizado",
      "xlo": 12,
      "xhi": 30,
      "dy": 22,
      "regex": "\\d{2}/\\d{2}/\\d{4}",
      "format": "date_iso"
    },

    "validade": {
      "pick": "under",
      "page": 1,
      "anchor": "Validade",
      "xlo": 12,
      "xhi": 30,
      "dy": 22,
      "regex": "\\d{2}/\\d{2}/\\d{4}",
      "format": "date_iso"
    },

    "uso_veiculo": {
      "pick": "under",
      "page": 1,
      "anchor": "Tipo de uso",
      "xlo": 12,
      "xhi": 40,
      "dy": 16,
      "regex": "^[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ /-]{3,28}$",
      "format": "upper"
    },

    "cep_circulacao": {
      "pick": "under",
      "page": 1,
      "anchor": "CEP de pernoite",
      "xlo": 14,
      "xhi": 30,
      "dy": 16,
      "regex": "\\d{5}-?\\d{3}",
      "format": "cep"
    },

    "colisao_incendio_roubo": {
      "pick": "text_regex",
      "page": 1,
      "anchor": "Compreensiva",
      "regex": "(Valor de mercado(?:\\s+referenciad\\w+)?)",
      "replace": [["\\bmercado\\b", "Mercado"], ["\\breferenciad", "Referenciad"]]
    },

    "franquia_veiculo": {
      "pick": "row",
      "page": 1,
      "anchor": "Compreensiva",
      "xmin": 340,
      "xmax": 470,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 100,
      "format": "currency"
    },

    "rcf_danos_materiais": {
      "pick": "row",
      "page": 1,
      "anchor": "RCF-V Danos Materiais",
      "xmin": 240,
      "xmax": 340,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 10000,
      "format": "currency"
    },

    "rcf_danos_pessoais": {
      "pick": "row",
      "page": 1,
      "anchor": "RCF-V Danos Corporais",
      "xmin": 240,
      "xmax": 340,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 10000,
      "format": "currency"
    },

    "protecao_pneu_roda_suspensao": {
      "pick": "under",
      "page": 1,
      "anchor": "Roda, Pneu e Suspensão",
      "occurrence": 2,
      "xlo": 12,
      "xhi": 40,
      "dy": 15,
      "regex": "^R\\$ ?[\\d.]+,\\d{2}$",
      "format": "currency"
    },

    "reparo_amassados": {
      "pick": "row",
      "page": 1,
      "anchor": "Pequenos Reparos",
      "xmin": 340,
      "xmax": 470,
      "regex": "^R\\$ ?[\\d.]+,\\d{2}$",
