      "anchor": "Troca de Para-choque",
      "xmin": 340,
      "xmax": 470,
      "regex": "^R\\$ ?[\\d.]+,\\d{2}$",
      "format": "currency"
    },

    "para_brisas": {
      "pick": "regex_near",
      "page": 2,
      "anchor": "Franquias: Vidros Para-Brisa",
      "span": 2,
      "regex": "Para-Brisa[^:/]{0,60}:\\s*(R\\$ ?[\\d.]+,\\d{2})",
      "format": "currency"
    },

    "farois": {
      "pick": "regex_near",
      "page": 2,
      "anchor": "Franquias: Vidros Para-Brisa",
      "span": 2,
      "regex": "Far[óo]is\\s+Convencionais[^:/]{0,40}:\\s*(R\\$ ?[\\d.]+,\\d{2})",
      "format": "currency"
    },

    "lanternas": {
      "pick": "regex_near",
      "page": 2,
      "anchor": "Franquias: Vidros Para-Brisa",
      "span": 2,
      "regex": "Lanternas\\s+Convencionais[^:/]{0,40}:\\s*(R\\$ ?[\\d.]+,\\d{2})",
      "format": "currency"
    },

    "retrovisores": {
      "pick": "regex_near",
      "page": 2,
      "anchor": "Franquias: Vidros Para-Brisa",
      "span": 2,
      "regex": "Retrovisores\\s*:\\s*(R\\$ ?[\\d.]+,\\d{2})",
      "format": "currency"
    },

    "km_reboque": {
      "pick": "text_regex",
      "page": 2,
      "anchor": "Km Ilimitado",
      "regex": "(km\\s?ilimitad\\w*)",
      "replace": [["^km", "KM"], ["^Km", "KM"]]
    },

    "diarias_carro_reserva": {
      "pick": "text_regex",
      "page": 2,
      "anchor": "Carro Reserva",
      "regex": "Carro Reserva[^\\d]{0,40}(\\d{1,2}\\s?di[aá]s?)"
    },

    "assistencia_residencial": {
      "pick": "text_regex",
      "page": 2,
      "anchor": "Serviços para a Residência",
      "regex": "(Servi[çc]os para a Resid[êe]ncia)",
      "replace": [["Servi[çc]os para a Resid[êe]ncia.*", "Sim"]]
    },

    "a_vista": {
      "pick": "row",
      "page": 2,
      "anchor": "Valor total",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 100,
      "format": "currency"
    },

    "parc_4x": {
