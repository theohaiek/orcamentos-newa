{
  "id": "justos",
  "label": "Justos Seguros — Seu plano / Detalhes do seu plano",
  "priority": 10,
  "match": ["JUSTOS SEGUROS S.A.", "CONDIÇÕES DE PAGAMENTO PARA O PLANO ANUAL"],
  "fields": {
    "seguradora": {
      "pick": "text_regex",
      "anchor": "JUSTOS SEGUROS S.A.",
      "regex": "JUSTOS SEGUROS S\\.A\\.",
      "format": "title"
    },

    "segurado": [
      {
        "pick": "regex_near",
        "anchor": "Nome CPF Classe",
        "span": 2,
        "regex": "b[oô]nus\\s+(.+)$",
        "not_regex": "\\bcep\\b|pernoite|placa|marca|corretor|susep|seu ve",
        "min_len": 6,
        "replace": [["\\d[\\d.\\-]*", " "]],
        "format": "upper"
      },
      {
        "pick": "regex_near",
        "anchor": "Nome CPF Classe",
        "span": 1,
        "regex": "b[oô]nus\\s+(.+)$",
        "min_len": 6,
        "replace": [["\\d[\\d.\\-]*", " "]],
        "format": "upper"
      }
    ],

    "veiculo": {
      "pick": "regex_near",
      "anchor": "Placa Marca Ano",
      "span": 3,
      "regex": "\\bAno\\s+\\S+\\s+(.+?\\s+(?:19|20)\\d{2}\\s+Modelo\\s+.+)$",
      "not_regex": "ESPECIFICA|CORRETOR|USO E",
      "min_len": 6,
      "replace": [["\\s+(?:19|20)\\d{2}\\s+Modelo\\s+", " "]]
    },

    "ano_modelo": {
      "pick": "under",
      "anchor": "Ano",
      "exact": true,
      "at_x": 386,
      "xlo": 20,
      "xhi": 60,
      "dy": 30,
      "regex": "\\b(?:19|20)\\d{2}\\b"
    },

    "validade": {
      "pick": "text_regex",
      "anchor": "Condições válidas até",
      "regex": "v[aá]lidas at[eé]\\s+(\\d{2}/\\d{2}/\\d{4})"
    },

    "uso_veiculo": {
      "pick": "text_regex",
      "anchor": "motorista profissional",
      "regex": "N[aã]o utiliza o ve[ií]culo como motorista profissional",
      "replace": [["^.+$", "PARTICULAR"]]
    },

    "cep_circulacao": {
      "pick": "under",
      "anchor": "CEP Pernoite",
      "exact": true,
      "at_x": 30,
      "xlo": 15,
      "xhi": 80,
      "dy": 30,
      "regex": "\\d{5}-?\\d{3}",
      "format": "cep"
    },

    "colisao_incendio_roubo": {
      "pick": "text_regex",
      "anchor": "Tabela FIPE",
      "regex": "Pagamos\\s+(\\d{1,3}%)\\*?\\s*da Tabela FIPE",
      "replace": [["%", "% FIPE"]]
    },

    "rcf_danos_materiais": {
      "pick": "under",
      "anchor": "DANOS MATERIAIS PARA TERCEIROS",
      "at_x": 306,
      "xlo": 20,
      "xhi": 120,
      "dy": 40,
      "regex": "\\d{1,3}(?:\\.\\d{3})+,\\d{2}",
      "min_value": 10000,
      "format": "currency"
    },

    "rcf_danos_pessoais": {
      "pick": "under",
