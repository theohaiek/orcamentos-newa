{
  "id": "mapfre",
  "label": "MAPFRE Seguros — Cotação de Seguro MAPFRE Auto",
  "priority": 10,
  "match": [
    "Cotação de Seguro MAPFRE Auto",
    "Processo SUSEP Automóvel"
  ],
  "fields": {
    "seguradora": {
      "pick": "text_regex",
      "anchor": "Cotação de Seguro MAPFRE Auto",
      "regex": "cota[çc][ãa]o de seguro (mapfre)",
      "format": "upper"
    },
    "segurado": {
      "pick": "kv",
      "anchor": "Segurado",
      "exact": true,
      "regex": "[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ.' ]{5,}",
      "min_len": 6,
      "not_regex": "\\d"
    },
    "veiculo": {
      "pick": "kv",
      "anchor": "Veículo",
      "exact": true,
      "regex": "(?:\\d+;){2,}\\s*[A-Z0-9]+\\s+(.+)$",
      "not_regex": "\\d{6,}",
      "min_len": 6
    },
    "ano_modelo": {
      "pick": "kv",
      "anchor": "Ano Modelo",
      "exact": true,
      "regex": "(?:19|20)\\d{2}(?:/(?:19|20)\\d{2})?"
    },
    "data_proposta": {
      "pick": "kv",
      "anchor": "Data da Cotação",
      "exact": true,
      "regex": "\\d{2}/\\d{2}/\\d{4}",
      "format": "date_iso"
    },
    "validade": {
      "pick": "kv",
      "anchor": "Validade da Cotação",
      "exact": true,
      "regex": "\\d{2}/\\d{2}/\\d{4}",
      "format": "date_iso"
    },
    "uso_veiculo": {
      "pick": "kv",
      "anchor": "Uso",
      "exact": true,
      "regex": "\\d+\\s*-\\s*[A-Za-zÀ-ÿ ]+",
      "format": [
        "strip_code",
        "upper"
      ]
    },
    "principal_condutor": {
      "pick": "kv",
      "anchor": "Nome do Principal Condutor",
      "regex": "[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ.' ]{5,}",
      "min_len": 6,
      "not_regex": "\\d"
    },
    "cep_circulacao": {
      "pick": "kv",
      "anchor": "CEP de pernoite",
      "regex": "\\d{5}-?\\d{3}",
      "format": "cep"
    },
    "condutores_18_26": {
      "pick": "row",
      "anchor": "condutores residentes entre 18 e 25",
      "regex": "[NS]\\s*-\\s*(?:SIM|N[ÃA]O)",
      "format": "simnao"
    },
    "colisao_incendio_roubo": {
      "pick": "row",
      "section": "Coberturas",
      "section_end": "Franquia(s)",
      "anchor": "Casco - Colisão",
      "ytol": 6,
      "xmin": 250,
      "xmax": 400,
      "regex": "\\d{1,3}\\s*%\\s*FIPE",
      "format": "upper"
    },
    "rcf_danos_materiais": {
      "pick": "row",
      "section": "Coberturas",
      "section_end": "Franquia(s)",
      "anchor": "RCFA - Danos Materiais",
      "ytol": 6,
      "xmin": 250,
      "xmax": 400,
      "regex": "\\d{1,3}(?:\\.\\d{3})+,\\d{2}",
      "min_value": 10000,
      "format": "currency"
    },
    "rcf_danos_pessoais": {
      "pick": "row",
      "section": "Coberturas",
      "section_end": "Franquia(s)",
      "anchor": "RCFA - Danos Corporais",
      "ytol": 6,
      "xmin": 250,
      "xmax": 400,
      "regex": "\\d{1,3}(?:\\.\\d{3})+,\\d{2}",
      "min_value": 10000,
      "format": "currency"
    },
    "km_reboque": {
      "pick": "text_regex",
      "anchor": "Extensão de Reboque",
      "regex": "reboque\\s+(ilimitado)",
      "replace": [
        [
          "^ilimitado$",
          "KM Ilimitado"
        ]
      ]
    },
    "diarias_carro_reserva": {
      "pick": "text_regex",
      "anchor": "Carro Reserva",
      "regex": "carro reserva\\s*-\\s*(\\d{1,3}\\s*di[aá]s?)"
    },
    "assistencia_residencial": {
      "pick": "row",
      "section": "Coberturas",
      "section_end": "Franquia(s)",
      "anchor": "Assistência Casa",
      "exact": true,
      "ytol": 6,
      "xmin": 450,
      "regex": "N[ÃA]O CONTRATADA|GRATUITA|CONTRATADA",
      "replace": [
        [
          "^(?:gratuita|contratada)$",
          "Sim"
        ],
        [
          "^n[ãa]o contratada$",
          "Não"
        ]
      ],
      "format": "simnao"
    },
    "franquia_veiculo": {
      "pick": "kv",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Casco",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 100,
      "format": "currency"
    },
    "para_brisas": {
      "pick": "row",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Para-brisa",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "format": "currency"
    },
    "farois": {
      "pick": "row",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Faróis Convencionais",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "format": "currency"
    },
    "lanternas": {
      "pick": "row",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Lanternas Convencionais",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "format": "currency"
    },
    "retrovisores": {
      "pick": "row",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Retrovisores Convencionais",
      "exact": true,
      "regex": "[\\d.]+,\\d{2}",
      "format": "currency"
    },
    "reparo_para_choque": {
      "pick": "row",
      "section": "Franquia(s)",
      "section_end": "Prêmios",
      "anchor": "Pintura/Para-choque",
      "regex": "[\\d.]+,\\d{2}",
      "format": "currency"
    },
    "a_vista": [
      {
        "pick": "under",
        "section": "Prêmios",
        "anchor": "Prêmio Total",
        "at_x": 440,
        "xlo": 14,
        "xhi": 60,
        "dy": 30,
        "regex": "[\\d.]+,\\d{2}",
        "min_value": 50,
        "format": "currency"
      },
      {
        "pick": "row",
        "anchor": "1x Sem Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "min_value": 50,
        "format": "currency"
      }
    ],
    "parc_4x": [
      {
        "pick": "row",
        "anchor": "4x Sem Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      },
      {
        "pick": "row",
        "anchor": "4x Com Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      }
    ],
    "parc_6x": [
      {
        "pick": "row",
        "anchor": "6x Sem Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      },
      {
        "pick": "row",
        "anchor": "6x Com Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      }
    ],
    "parc_10x": [
      {
        "pick": "row",
        "anchor": "10x Sem Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      },
      {
        "pick": "row",
        "anchor": "10x Com Juros",
        "exact": true,
        "regex": "R\\$ ?[\\d.]+,\\d{2}",
        "format": "currency"
      }
    ]
  }
}
