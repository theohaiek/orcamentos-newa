{
  "id": "suhai",
  "label": "Suhai Seguradora S.A — Cotação de Seguro Auto",
  "priority": 10,
  "match": [
    "suhai seguradora s.a",
    "cotação de seguro"
  ],
  "fields": {
    "seguradora": {
      "pick": "text_regex",
      "regex": "(SUHAI\\s+SEGURADORA\\s+S\\.?A\\.?)",
      "format": "upper"
    },
    "segurado": {
      "pick": "under",
      "anchor": "Nome/Razão Social",
      "exact": true,
      "section": "DADOS DO PROPONENTE",
      "section_end": "DADOS DO VEICULO SEGURADO",
      "dy": 20,
      "xlo": 12,
      "xhi": 120,
      "regex": "[A-Za-zÀ-ÿ][A-Za-zÀ-ÿ'. ]{5,}",
      "not_regex": "corretagen|newa|ltda|seguros|cadastrad",
      "min_len": 6
    },
    "veiculo": [
      {
        "pick": "text_regex",
        "anchor": "Código FIPE",
        "section": "DADOS DO VEICULO SEGURADO",
        "section_end": "OPÇÕES",
        "regex": "\\d{6}-\\d\\s+([A-Za-zÀ-ÿ][A-Za-zÀ-ÿ0-9.,'/\\- ]{8,})$",
        "not_regex": "\\d{6}-\\d|[A-Za-z0-9]{16,}|chassi|placa|c[oó]digo",
        "min_len": 10,
        "max_words": 14
      },
      {
        "pick": "regex_near",
        "anchor": "Código FIPE",
        "span": 1,
        "regex": "\\d{6}-\\d\\s+([A-Za-zÀ-ÿ][A-Za-zÀ-ÿ0-9.,'/\\- ]{8,})$",
        "not_regex": "\\d{6}-\\d|[A-Za-z0-9]{16,}|chassi|placa|c[oó]digo",
        "min_len": 10,
        "max_words": 14
      }
    ],
    "ano_modelo": {
      "pick": "under",
      "anchor": "Ano Fabr./Modelo",
      "exact": true,
      "dy": 20,
      "xlo": 12,
      "xhi": 90,
      "regex": "\\d{4}/\\d{4}|\\d{4}"
    },
    "data_proposta": {
      "pick": "kv",
      "anchor": "Data",
      "exact": true,
      "regex": "\\d{2}/\\d{2}/\\d{4}",
      "format": "date_iso"
    },
    "validade": {
      "pick": "kv",
      "anchor": "Validade desta cotação",
      "regex": "\\d{1,3}\\s*dias?",
      "max_words": 3
    },
    "uso_veiculo": {
      "pick": "under",
      "anchor": "Utilização",
      "exact": true,
      "dy": 20,
      "xlo": 12,
      "xhi": 60,
      "regex": "[A-Za-zÀ-ÿ]{4,}",
      "max_words": 2,
      "format": "upper"
    },
    "cep_circulacao": {
      "pick": "under",
      "anchor": "CEP Pernoite",
      "dy": 22,
      "xlo": 12,
      "xhi": 120,
      "regex": "/(\\d{8})",
      "format": "cep"
    },
    "colisao_incendio_roubo": {
      "pick": "row",
      "anchor": "Compreensiva",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "xmax": 200,
      "regex": "(\\d{1,3}\\s*%\\s*Fipe)",
      "format": "upper"
    },
    "rcf_danos_materiais": {
      "pick": "row",
      "anchor": "RCF - Danos Materiais",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "ytol": 5,
      "xmax": 200,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 5000,
      "format": "currency"
    },
    "rcf_danos_pessoais": {
      "pick": "row",
      "anchor": "RCF - Danos Corporais",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "ytol": 5,
      "xmax": 200,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 5000,
      "format": "currency"
    },
    "km_reboque": {
      "pick": "under",
      "anchor": "Assistência 24 horas",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "dy": 15,
      "xlo": 12,
      "xhi": 200,
      "regex": "\\d{2,4}\\s*km",
      "replace": [
        [
          "\\s*km$",
          " KM"
        ]
      ],
      "format": "upper"
    },
    "franquia_veiculo": {
      "pick": "row",
      "anchor": "Franquia Perdas Parciais",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "regex": "R\\$\\s*([\\d.]+,\\d{2})",
      "min_value": 100,
      "format": "currency"
    },
    "a_vista": {
      "pick": "row",
      "anchor": "Prêmio total, com IOF",
      "exact": true,
      "section": "COBERTURAS",
      "section_end": "(*) Cobertura PT Colis",
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 100,
      "format": "currency"
    },
    "parc_4x": {
      "pick": "row",
      "anchor": "4",
      "exact": true,
      "section": "Parcelas",
      "section_end": "Validade desta cotação",
      "xmax": 200,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 1,
      "format": "currency"
    },
    "parc_6x": {
      "pick": "row",
      "anchor": "6",
      "exact": true,
      "section": "Parcelas",
      "section_end": "Validade desta cotação",
      "xmax": 200,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 1,
      "format": "currency"
    },
    "parc_10x": {
      "pick": "row",
      "anchor": "10",
      "exact": true,
      "section": "Parcelas",
      "section_end": "Validade desta cotação",
      "xmax": 200,
      "regex": "[\\d.]+,\\d{2}",
      "min_value": 1,
      "format": "currency"
    }
  }
}
